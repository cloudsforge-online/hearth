# Copy to .env — which is gitignored at the repository root — or export these.
#
# THE PLACEHOLDER BELOW IS DELIBERATELY NOT A VALID KEY. It is 64 'x'
# characters, so the faucet refuses it with "the faucet key is not 32 bytes of
# hex" rather than starting up with something that looks plausible.

# --- the key -----------------------------------------------------------------
# One of these two, never both.
#
# Prefer the file. It keeps the key out of the process environment, out of `ps`,
# out of shell history and out of a container inspect. The faucet REFUSES a path
# that resolves inside this repository, and refuses a file readable by group or
# other.
#HEARTH_FAUCET_KEY_FILE=/home/you/.hearth/faucet.key      # chmod 600
HEARTH_FAUCET_PRIVATE_KEY=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- the network -------------------------------------------------------------
# There is no public Hearth endpoint yet (phase 5 has not landed). Point this at
# your own node, or at tools/rpc-probe/stub.js to exercise the wiring.
HEARTH_RPC_URL=http://127.0.0.1:8645

# A mismatch between this and the node's eth_chainId is FATAL at boot, on
# purpose: a testnet faucet pointed at mainnet is an unauthenticated withdrawal
# endpoint.
HEARTH_CHAIN_ID=7411

# --- where to listen ---------------------------------------------------------
HEARTH_FAUCET_PORT=9646
HEARTH_FAUCET_HOST=127.0.0.1

# There is no TLS and no auth in this process. Put it behind a proxy.
# x-forwarded-for is a header the CLIENT sets: believe it only if something in
# front of you overwrites it. On while directly exposed makes the per-IP limit
# decorative; off while behind nginx locks the world out after three drips.
HEARTH_FAUCET_TRUST_PROXY=0

# Browser origins allowed to POST /drip. An allowlist, never a wildcard.
#CORS_ORIGINS=https://faucet.example.com

# --- payout ------------------------------------------------------------------
# Fixed. The caller supplies an address and nothing else.
HEARTH_FAUCET_DRIP_EMBER=10

# One drip per address per this many seconds.
HEARTH_FAUCET_ADDRESS_COOLDOWN_S=86400

# Per-IP. Weak on its own — an IPv6 /64 has 2^64 addresses — but free.
HEARTH_FAUCET_IP_LIMIT=3
HEARTH_FAUCET_IP_WINDOW_S=86400

# THE CONTROL THAT ACTUALLY BOUNDS THE LOSS. However many addresses, however
# many IPs, the faucet cannot pay out more than this per window. Set it to what
# you are willing to lose in a day.
HEARTH_FAUCET_DAILY_CAP_EMBER=1000
HEARTH_FAUCET_DAILY_WINDOW_S=86400

# Refuse an address that already holds this much. A faucet exists to unblock
# someone with nothing.
HEARTH_FAUCET_MAX_BALANCE_EMBER=100

# Stop cleanly at this balance rather than broadcasting transactions the node
# will reject for insufficient funds.
HEARTH_FAUCET_RESERVE_EMBER=1

# Legacy (type 0) pricing — v1 has no EIP-1559 fee market.
HEARTH_FAUCET_GAS_PRICE_WEI=1000000000

# --- state -------------------------------------------------------------------
# Persisted so that a restart is not an amnesty. Put it on a volume.
HEARTH_FAUCET_STATE=./faucet-state.json

HEARTH_FAUCET_LOG_LEVEL=info
#HEARTH_FAUCET_LOG_FORMAT=json
