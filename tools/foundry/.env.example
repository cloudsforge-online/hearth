# Copy to .env — gitignored at the repository root — or export these.
# THE KEY BELOW IS DELIBERATELY NOT VALID: 64 'x' characters, not hex.
#
# Foundry does not read .env automatically for `forge create` / `cast`; export
# these, or use `forge script --rpc-url hearth`, which resolves
# [rpc_endpoints] in foundry.toml against the environment.

# No public Hearth endpoint exists yet (phase 5 has not landed). Point this at
# your own node, or at `node ../rpc-probe/stub.js --port 8745`.
HEARTH_RPC_URL=http://127.0.0.1:8745

HEARTH_PRIVATE_KEY=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REMINDER, because it is the thing that will stop you first: every BROADCASTING
# Foundry command against Hearth needs `--legacy` on the command line. Hearth v1
# has no EIP-1559, forge calls eth_feeHistory unconditionally, and there is no
# foundry.toml key and no environment variable for this. See README.md.
