# Copy to .env — gitignored at the repository root — or export these.
# THE KEY BELOW IS DELIBERATELY NOT VALID: 64 'x' characters, not hex.

# There is no public Hearth endpoint yet: phase 5 (consensus) has not landed.
# Point this at your own node, or at `node ../rpc-probe/stub.js --port 8745` to
# exercise the wiring without a chain.
HEARTH_RPC_URL=http://127.0.0.1:8745

HEARTH_PRIVATE_KEY=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only for scripts/deploy-dex.js, and it MUST be a multisig or governance
# contract — not the deployer, not any EOA. It controls the Uniswap V2 protocol
# fee switch, has no timelock and no two-step handover, and cannot be safely
# moved later: moving it requires the very key you would be trying to stop
# relying on (docs/evm-spec.md §7). The script refuses to run without it and
# refuses if it equals the deployer.
#HEARTH_FEE_TO_SETTER=0x…

# Only for scripts/interact.js.
#GREETER=0x…
