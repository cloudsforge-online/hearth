# chain / wallet data
data/
**/data/
*.ndjson

# node
node_modules/
npm-debug.log*

# the full ethereum/tests corpus, fetched by node/scripts/fetch-vectors.sh.
# The small representative subset under node/test/conformance/fixtures/ IS
# committed, so the conformance harness runs offline.
node/test/conformance/vectors/

# rust
**/target/
**/*.rs.bk

# tauri desktop app
app-desktop/src-tauri/gen/
# All of it is generated by `npm run icons` from web/assets/logo.svg, including
# the android/ and ios/ sets tauri-cli emits whether or not there is a mobile
# app — and there is not one, deliberately: see docs/mining.md on why a phone
# should not do proof-of-work.
app-desktop/src-tauri/icons/*
!app-desktop/src-tauri/icons/README.md
# The bundled Node runtime, fetched and SHA-256-verified against nodejs.org by
# app-desktop/scripts/fetch-node.mjs. ~110 MB per platform, so it is a build
# step and not a checked-in binary — and a binary in git is one nobody re-checks.
app-desktop/src-tauri/binaries/
# What --selftest and the app write when run from a checkout.
app-desktop/**/hearth-selftest-data/
app-desktop/**/hearth-desktop-data/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# logs / tmp
*.log
tmp/

# tools/verify caches solc builds here — ~9 MB per compiler release, fetched
# from binaries.soliditylang.org and checked against its published keccak256.
tools/verify/.solc-cache/
# Runtime state of the two listing services. Both are rebuildable from a node.
tools/verify/verified/
tools/explorer-api/explorer-index/

# scripts/run-local-network.sh writes these at the repo root. In the monorepo
# they were covered by the root .gitignore; standalone, this file is the only
# thing covering them.
.netdata/
.netlogs/

# secrets
.env
.env.*
!.env.example

# site build output
dist/

# Agent worktrees, created transiently while building. Never part of the repo.
.claude/
