{
  "name": "@cloudsforge/hearth-node",
  "version": "0.1.0",
  "description": "Hearth reference node — a runnable full node, wallet and miner for the Ember (EMBER) currency",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudsforge-online/hearth.git",
    "directory": "node"
  },
  "type": "commonjs",
  "main": "src/node.js",
  "exports": {
    ".": "./src/node.js",
    "./crypto": "./src/crypto.js",
    "./chain": "./src/chain.js",
    "./tx": "./src/tx.js",
    "./wallet": "./src/wallet.js",
    "./params": "./src/params.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "hearthd": "bin/hearthd.js",
    "hearth-cli": "bin/hearth-cli.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/hearthd.js --mine",
    "node": "node bin/hearthd.js",
    "cli": "node bin/hearth-cli.js",
    "test": "node test/unit.js && node test/e2e.js && node test/records.js && node test/browser-pow.js && node test/mining-api.js && node test/p2p-fork.js",
    "test:p2p": "node test/p2p-fork.js"
  },
  "engines": { "node": ">=18" }
}
